rules_version = '2';
// Gestor de Obras — regras do Firestore
// Cada construtora só enxerga os próprios dados. Construtora vencida ou bloqueada perde acesso aos dados
// (o próprio servidor do Google barra, não só a tela). Troque o e-mail abaixo se mudar o administrador.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function admin() { return logado() && request.auth.token.email in ['jeffersonramalhopb@gmail.com']; }
    function meuPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function daEmpresa(eid) { return temPerfil() && meuPerfil().empresaId == eid; }
    function adminDaEmpresa(eid) { return daEmpresa(eid) && meuPerfil().papel == 'admin'; }
    function empresaAtiva(eid) {
      let e = get(/databases/$(database)/documents/empresas/$(eid)).data;
      return e.status != 'bloqueado' && e.venceTs > request.time;
    }

    // Perfis de usuário (quem é de qual construtora)
    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin() || daEmpresa(resource.data.empresaId));
      allow list: if admin() || (temPerfil() && resource.data.empresaId == meuPerfil().empresaId);
      // Cadastro novo: a pessoa cria o próprio perfil como dona da construtora com o mesmo id
      allow create: if logado() && (
        (request.auth.uid == uid && request.resource.data.empresaId == uid && request.resource.data.papel == 'admin')
        || adminDaEmpresa(request.resource.data.empresaId)
        || admin());
      allow update, delete: if admin() || adminDaEmpresa(resource.data.empresaId);
    }

    // Construtoras (assinantes)
    match /empresas/{eid} {
      allow get: if admin() || daEmpresa(eid);
      allow list: if admin();
      allow create: if logado() && eid == request.auth.uid
        && request.resource.data.status == 'teste'
        && request.resource.data.venceTs < request.time + duration.value(8, 'd');
      // A construtora edita nome/telefone, mas nunca a própria assinatura
      allow update: if admin() || (adminDaEmpresa(eid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'venceTs']));
      allow delete: if admin();

      // Todos os dados da construtora: obras, financeiro, materiais...
      match /{colecao}/{doc} {
        allow read, write: if admin() || (daEmpresa(eid) && empresaAtiva(eid));
      }
    }

    // Assinatura de contrato pelo link: o cliente (sem login) só consegue assinar uma vez
    match /assinaturas/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if daEmpresa(request.resource.data.empresaId);
      allow update: if daEmpresa(resource.data.empresaId)
        || (resource.data.status == 'pendente' && request.resource.data.status == 'assinado'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assinatura']));
      allow delete: if daEmpresa(resource.data.empresaId);
    }

    // Portal do cliente: página pública e resumida (sem valores)
    match /portais/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if daEmpresa(request.resource.data.empresaId);
      allow update: if daEmpresa(resource.data.empresaId) && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if daEmpresa(resource.data.empresaId);
    }
  }
}
